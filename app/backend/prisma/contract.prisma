// use prisma-8

model Job {
  id         Uuid     @id @default(uuid())
  name       String
  status     String
  priority   String
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("jobs")
}
model worker{
  id             Uuid @id @default(uuid())
  name           String
  status         String
  lastHeartbeat  DateTime
  createdAt      DateTime @default(now())

  @@map("workers")
}